# ============================================================
# Oppi API — variables de entorno
# Copiá a `.env` para desarrollo local. En producción (Render/Railway/
# Docker) setealas en el dashboard del servicio. NUNCA commitees el `.env`.
#
# Convención en este archivo:
#   [REQUERIDA]  → la API no arranca sin ella (ver src/lib/config.js)
#   [opcional]   → tiene default razonable; solo setear si se necesita
# ============================================================

# ---- Servidor ----
# [opcional] Puerto donde escucha la API.
PORT=3000

# ---- Base de datos ----
# [opcional] Sin DATABASE_URL → SQLite local en DB_PATH (cero config, ideal para dev).
DB_PATH=./data/oppi.db
# [opcional] Con DATABASE_URL → Postgres (producción). Formato:
#   postgres://usuario:password@host:5432/oppi
# En Render/Railway sale del addon de Postgres (internal URL).
DATABASE_URL=
# [opcional] Conexiones máximas del pool de Postgres.
PG_POOL_MAX=10
# [opcional] PG_SSL=true si tu Postgres exige SSL (algunos PaaS). Default: false.
PG_SSL=false

# ---- Auth ----
# [REQUERIDA] Secreto para firmar los JWT. Generá uno largo y aleatorio:
#    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=oppi-dev-secret
# [REQUERIDA en producción] Secreto para los crons externos (generate-reminders,
# send-due): el scheduler manda el header `x-cron-secret: <valor>`.
# Si no lo seteás, esos endpoints exigen JWT de usuario como siempre
# (src/lib/config.js te avisa con un warning al arrancar).
CRON_SECRET=
# [opcional] Email que nace como admin: si te registrás con este email,
# la cuenta sale con is_admin=1 (src/routes/auth.js). El seed también lo usa:
# si coincide con un usuario del seed, lo marca admin (src/seed.js).
# Poné tu email ANTES de correr el seed o registrarte.
ADMIN_EMAIL=

# ---- Negocio ----
# [opcional] Crédito en Gs. que suma canjear un código de referido.
REFERRAL_BONUS_GS=20000
# [opcional] Piloto de la nueva política de cancelación (default: true).
# Con el piloto prendido, cancelar NO mueve plata (no se llama a la pasarela).
# Se apaga con: false | 0 | no | off (src/lib/cancellation.js).
CANCELLATION_PILOT_MODE=true
# [opcional] % de seña por defecto al aceptar una oferta handyman (1-100).
JOB_DEPOSIT_PERCENT=30

# ---- Pagos (src/lib/payments.js) ----
# [opcional] Provider: mock | bancard (default: mock)
# - mock: simula retenciones/capturas (para dev y demo). No mueve plata.
# - bancard: pasarela paraguaya Bancard vPOS (requiere las credenciales de abajo).
PAYMENT_PROVIDER=mock
# [REQUERIDA si PAYMENT_PROVIDER=bancard] Llave pública del comercio.
# Dónde: portal de comercios de Bancard → credenciales del comercio (ver PAGOS.md).
PAYMENT_BANCARD_PUBLIC_KEY=
# [REQUERIDA si PAYMENT_PROVIDER=bancard] Llave privada del comercio (solo se usa
# para firmar los tokens MD5 de cada operación; nunca viaja en claro).
# Dónde: portal de comercios de Bancard (ver PAGOS.md).
PAYMENT_BANCARD_PRIVATE_KEY=
# [opcional] staging | prod (default: staging). ¡No pongas prod sin haber
# certificado con Bancard!
PAYMENT_BANCARD_ENV=staging
# [opcional] A dónde vuelve el browser del cliente después de pagar en el iframe
# de Bancard. Si se omite, Bancard usa la configurada en el portal.
PAYMENT_BANCARD_RETURN_URL=
# [opcional] A dónde vuelve si el cliente cancela el pago.
PAYMENT_BANCARD_CANCEL_URL=

# ---- Push (src/lib/notifications.js) ----
# [opcional] Provider: mock | fcm | apns (default: mock)
# - mock: no envía nada afuera (las notificaciones quedan en la DB).
# - fcm: Firebase Cloud Messaging (Android/web).
# - apns: Apple Push Notification service (iOS).
PUSH_PROVIDER=mock
# [REQUERIDA si PUSH_PROVIDER=fcm] Id del proyecto Firebase.
# Dónde: console.firebase.google.com → configuración del proyecto (ver NOTIFICACIONES.md).
PUSH_FCM_PROJECT_ID=
# [REQUERIDA si PUSH_PROVIDER=fcm] Contenido del JSON de la service account,
# o ruta al archivo .json descargado (nunca commitearlo).
# Dónde: Firebase → Configuración → Cuentas de servicio → Generar nueva clave privada.
PUSH_FCM_SERVICE_ACCOUNT_JSON=
# [REQUERIDA si PUSH_PROVIDER=apns] Key ID de 10 caracteres de la APNs Key.
# Dónde: developer.apple.com/account → Certificates, Identifiers & Profiles → Keys.
PUSH_APNS_KEY_ID=
# [REQUERIDA si PUSH_PROVIDER=apns] Team ID (10 caracteres, arriba a la derecha
# en developer.apple.com → Membership).
PUSH_APNS_TEAM_ID=
# [REQUERIDA si PUSH_PROVIDER=apns] Ruta al archivo .p8 descargado al crear la Key
# (nunca commitearlo; en producción, montarlo como secreto/archivo).
PUSH_APNS_KEY_FILE=
# [REQUERIDA si PUSH_PROVIDER=apns] Bundle ID de la app Oppi (ej. com.oppi.app).
PUSH_APNS_BUNDLE_ID=
# [opcional] sandbox | prod (default: sandbox). ¡prod solo con build de App Store!
PUSH_APNS_ENV=sandbox

# ---- Storage de fotos (src/lib/storage.js) ----
# [opcional] Driver: local | s3 (default: local)
# - local: guarda en disco y sirve en /uploads/*. Funciona ya.
# - s3: compatible S3 (AWS S3, Cloudflare R2, MinIO). Requiere las de abajo.
STORAGE_DRIVER=local
# [opcional] Carpeta local de uploads (default: ./data/uploads).
STORAGE_LOCAL_DIR=./data/uploads
# [REQUERIDAS si STORAGE_DRIVER=s3] Endpoint, bucket, región y access keys.
STORAGE_S3_ENDPOINT=
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_KEY=
STORAGE_S3_SECRET=
# [opcional] Base pública/CDN por delante del bucket:
STORAGE_S3_PUBLIC_URL=
